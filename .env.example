# Copy to .env.dev only if you want to use scripts/run-dev.ps1.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# These match compose.dev.yml by default.
DB_URL=jdbc:postgresql://localhost:5432/bus_transport_db
DB_USERNAME=postgres
DB_PASSWORD=root

# Development-only sample data. Never enable sample seeding in prod.
APP_SEED_ENABLED=true

# Optional override for development CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production normally sets this to true behind HTTPS.
COOKIE_SECURE=false
